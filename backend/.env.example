# Copy to backend/.env and fill in. Real environment variables take precedence over this file.

# Folder with Daten.zip, actual-date-swiss-service-point.csv and gtfs_*.zip (default: the folder above the repo)
SBB_DATA_DIR=
# SQLite file built by `python -m sbb_backend.ingest` (default: backend/data/sbb.db)
SBB_DB_PATH=
# Optional: a specific GTFS zip instead of the newest gtfs_*.zip
SBB_GTFS_ZIP=

# Together AI — https://api.together.ai (leave empty to run without AI features)
TOGETHER_API_KEY=
TOGETHER_CHAT_MODEL=Qwen/Qwen3.5-9B
# The Together docs call Qwen3.5 with reasoning disabled; set to false if your chat model rejects that field
TOGETHER_DISABLE_REASONING=true
TOGETHER_STT_MODEL=openai/whisper-large-v3
# Orpheus speaks English only. For German/French/Italian, use a multilingual model with a voice per language,
# for example TOGETHER_TTS_MODEL=cartesia/sonic-2 and the voices below (tested: clear speech in all four languages).
TOGETHER_TTS_MODEL=canopylabs/orpheus-3b-0.1-ft
TOGETHER_TTS_VOICE=tara
# Optional voice per language (used when set; otherwise TOGETHER_TTS_VOICE)
TOGETHER_TTS_VOICE_EN=
TOGETHER_TTS_VOICE_DE=
TOGETHER_TTS_VOICE_FR=
TOGETHER_TTS_VOICE_IT=

# Google Places API (New), optional: real cafés, sights and parks near the station, with photos, on the
# "what to do while you wait" screens. Enable "Places API (New)" for the key, and set a daily quota in
# Google Cloud Console so the free monthly allowance is never exceeded. Without a key the kiosk shows
# the hand-written ideas.
GOOGLE_MAPS_API_KEY=
