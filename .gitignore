# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# ---------------------------------------------------------------- front-end (Next.js)

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (only the examples are committed; they may hold API keys)
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# ---------------------------------------------------------------- back-end (Python)

__pycache__/
*.py[cod]
.venv/
venv/
.pytest_cache/

# Built database and raw SBB data (large, and not for publication)
backend/data/
*.db
*.building
*.zip
*.csv
*.xlsx

# Editors / OS
.vscode/
.idea/
Thumbs.db
