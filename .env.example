# Copy to .env.local. Only read on the server (no NEXT_PUBLIC_ prefix), never sent to the browser.

# Python backend (backend/). Leave empty to run the kiosk on mock data only.
BACKEND_URL=http://127.0.0.1:8000
# Simulated "now" of the kiosk, Swiss local time with offset. The disruption data covers September 2026.
DEMO_AT=2026-09-10T11:05:00+02:00
# Kiosk station and the destination read from the (simulated) ticket, as 7-digit station numbers.
KIOSK_STATION=8503000
TRIP_DESTINATION=8509000
# 1 = show an error page when the backend fails, instead of falling back to mock data (useful when testing).
BACKEND_STRICT=

# The Together AI key belongs to the backend: put it in backend/.env (see backend/.env.example).
